# Tokens for the existing xlsx_fuzzer (string-grid harness): XML escapes,
# UTF-8 edge bytes, formulas, hyperlinks, sheet references.
xml_amp="&amp;"
xml_lt="&lt;"
xml_gt="&gt;"
xml_quot="&quot;"
xml_apos="&apos;"
xml_x0a="&#x0a;"
xml_x9="&#x9;"
utf8_e="\xc3\xa9"
utf8_cjk="\xe4\xb8\xad"
utf8_check="\xe2\x9c\x93"
utf8_invalid="\xff\xfe"
formula_sum="=SUM(A1:A2)"
formula_if="=IF(A1>1,\"Y\",\"N\")"
sheet_ref="Sheet1!$A$1"
url_http="http://example.com/"
url_mailto="mailto:x@y.z"
url_internal="internal:'Sheet 1'!A1"
long_a="AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
